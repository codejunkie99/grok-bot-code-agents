#!/usr/bin/env python3
"""codex-sessions: list and tidy Codex threads on a local `codex app-server` (stdlib only).

  codex-sessions [list] [--all] [--archived] [--cwd DIR]   named threads (--all: unnamed too)
  codex-sessions find <term>                               substring search on thread names
  codex-sessions name <threadId> <name>                    thread/name/set
  codex-sessions compact <threadId>                        thread/compact/start
  codex-sessions archive|unarchive <threadId>              thread/archive / thread/unarchive
  Global: --url ws://HOST:PORT  (or env CODEX_APP_SERVER_URL, or CODEX_WS_HOST/CODEX_WS_PORT
                                 as used by codex_ws.py; default ws://127.0.0.1:4500)
          --json                 print raw thread objects

Lists every source kind (cli, vscode, exec, appServer), so `codex exec` sessions show up too.
Naming convention (documentation only; pick your own): <bot>-<project>-<task type>.
"""
import base64, json, os, socket, struct, sys, time
from urllib.parse import urlparse

DEFAULT_URL = "ws://127.0.0.1:4500"
SOURCE_KINDS = ["cli", "vscode", "exec", "appServer"]


class AppServer:
    """Minimal WebSocket JSON-RPC 2.0 client: one JSON message per text frame."""

    def __init__(self, url, timeout=30):
        u = urlparse(url)
        if u.scheme != "ws" or not u.hostname:
            raise SystemExit(f"bad url {url!r}; expected ws://HOST:PORT")
        self.host, self.port = u.hostname, u.port or 80
        self.sock = socket.create_connection((self.host, self.port), timeout=timeout)
        self.buf, self.next_id = b"", 1
        key = base64.b64encode(os.urandom(16)).decode()
        self.sock.sendall((f"GET {u.path or '/'} HTTP/1.1\r\nHost: {self.host}:{self.port}\r\n"
                           "Upgrade: websocket\r\nConnection: Upgrade\r\n"
                           f"Sec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n").encode())
        while b"\r\n\r\n" not in self.buf:
            chunk = self.sock.recv(4096)
            if not chunk:
                raise SystemExit("connection closed during handshake")
            self.buf += chunk
        head, self.buf = self.buf.split(b"\r\n\r\n", 1)
        status = head.split(b"\r\n", 1)[0].decode(errors="replace")
        if " 101 " not in status:
            raise SystemExit(f"websocket handshake failed: {status}")

    def _read(self, n):
        while len(self.buf) < n:
            chunk = self.sock.recv(65536)
            if not chunk:
                raise EOFError("server closed the connection")
            self.buf += chunk
        out, self.buf = self.buf[:n], self.buf[n:]
        return out

    def _send_frame(self, opcode, data):
        mask, n = os.urandom(4), len(data)
        if n < 126:
            hdr = struct.pack("!BB", 0x80 | opcode, 0x80 | n)
        elif n < 65536:
            hdr = struct.pack("!BBH", 0x80 | opcode, 0x80 | 126, n)
        else:
            hdr = struct.pack("!BBQ", 0x80 | opcode, 0x80 | 127, n)
        self.sock.sendall(hdr + mask + bytes(b ^ mask[i % 4] for i, b in enumerate(data)))

    def send(self, obj):
        self._send_frame(0x1, json.dumps(obj).encode())

    def recv(self):
        msg = b""
        while True:
            b1, b2 = self._read(2)
            n = b2 & 0x7F
            if n == 126:
                n = struct.unpack("!H", self._read(2))[0]
            elif n == 127:
                n = struct.unpack("!Q", self._read(8))[0]
            payload = self._read(n)
            op = b1 & 0x0F
            if op == 0x9:          # ping -> pong
                self._send_frame(0xA, payload)
                continue
            if op == 0xA:
                continue
            if op == 0x8:
                raise EOFError("server closed the connection")
            msg += payload
            if b1 & 0x80:
                return json.loads(msg)

    def call(self, method, params):
        rid, self.next_id = self.next_id, self.next_id + 1
        self.send({"jsonrpc": "2.0", "id": rid, "method": method, "params": params})
        while True:
            m = self.recv()
            if m.get("id") == rid and "method" not in m:
                if "error" in m:
                    raise SystemExit(f"{method}: {m['error'].get('message', m['error'])}")
                return m.get("result") or {}
            # notifications and server requests are ignored by this read-mostly helper

    def initialize(self):
        self.call("initialize", {"clientInfo": {"name": "codex-sessions", "version": "0.1.0"}})
        self.send({"jsonrpc": "2.0", "method": "initialized"})

    def close(self):
        try:
            self._send_frame(0x8, b"")
        finally:
            self.sock.close()


def list_threads(srv, **params):
    out, cursor = [], None
    while True:
        q = {"limit": 100, "sourceKinds": SOURCE_KINDS, **params}
        if cursor:
            q["cursor"] = cursor
        r = srv.call("thread/list", q)
        out += r.get("data", [])
        cursor = r.get("nextCursor")
        if not cursor:
            return out


def status_of(t):
    s = t.get("status")
    return s.get("type", "?") if isinstance(s, dict) else str(s)


def show(threads, include_unnamed, as_json):
    rows = threads if include_unnamed else [t for t in threads if t.get("name")]
    rows.sort(key=lambda t: (t.get("name") or "\uffff", -(t.get("updatedAt") or 0)))
    if as_json:
        print(json.dumps(rows, indent=2, ensure_ascii=False))
        return
    for t in rows:
        when = time.strftime("%Y-%m-%d %H:%M", time.localtime(t.get("updatedAt") or 0))
        print(f"{(t.get('name') or '(unnamed)'):<40} {when}  {status_of(t):<9} "
              f"{str(t.get('source', '')):<9} {t.get('cwd', '')}  {t.get('id')}")
    hidden = len(threads) - len(rows)
    print(f"-- {len(rows)} shown" + (f", {hidden} unnamed hidden (use --all)" if hidden else ""))


def pop_opt(args, flag, has_value=False):
    if flag not in args:
        return None
    i = args.index(flag)
    if has_value:
        if i + 1 >= len(args):
            raise SystemExit(f"{flag} needs a value")
        val = args[i + 1]
        del args[i:i + 2]
        return val
    del args[i]
    return True


def main(argv):
    args = list(argv)
    if pop_opt(args, "-h") or pop_opt(args, "--help"):
        print(__doc__)
        return 0
    url = pop_opt(args, "--url", True) or os.environ.get("CODEX_APP_SERVER_URL")
    if not url and (os.environ.get("CODEX_WS_HOST") or os.environ.get("CODEX_WS_PORT")):
        url = f"ws://{os.environ.get('CODEX_WS_HOST', '127.0.0.1')}:{os.environ.get('CODEX_WS_PORT', '4500')}"
    url = url or DEFAULT_URL
    as_json = bool(pop_opt(args, "--json"))
    include_all = bool(pop_opt(args, "--all"))
    archived = bool(pop_opt(args, "--archived"))
    cwd = pop_opt(args, "--cwd", True)
    cmd = args.pop(0) if args else "list"

    need = {"list": 0, "find": 1, "name": 2, "compact": 1, "archive": 1, "unarchive": 1}
    if cmd not in need or len(args) != need[cmd]:
        print(__doc__, file=sys.stderr)
        return 2

    srv = AppServer(url)
    try:
        srv.initialize()
        if cmd == "list":
            p = {}
            if archived:
                p["archived"] = True
            if cwd:
                p["cwd"] = os.path.abspath(cwd)
            show(list_threads(srv, **p), include_all, as_json)
        elif cmd == "find":
            show(list_threads(srv, searchTerm=args[0]), True, as_json)
        elif cmd == "name":
            srv.call("thread/name/set", {"threadId": args[0], "name": args[1]})
            print("ok")
        else:
            method = {"compact": "thread/compact/start", "archive": "thread/archive",
                      "unarchive": "thread/unarchive"}[cmd]
            srv.call(method, {"threadId": args[0]})
            print("ok")
    finally:
        srv.close()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
